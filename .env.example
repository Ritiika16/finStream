# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=financial.transactions.raw
KAFKA_INVALID_TOPIC=financial.transactions.invalid
KAFKA_ALERTS_TOPIC=financial.transactions.alerts

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_streaming
POSTGRES_USER=finstream
POSTGRES_PASSWORD=change_me

# Producer Configuration
TRANSACTIONS_PER_SECOND=100

# Spark Configuration
SPARK_APP_NAME=FinancialTransactionStreaming
SPARK_CHECKPOINT_DIR=./checkpoints
